generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum StudySessionType {
  LEARNING
  REVIEW
  SMART_STUDY
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum SavedWordSource {
  LESSON
  DICTIONARY
  AI_TUTOR
  MANUAL
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum QuizAttemptStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum QuizQuestionType {
  WORD_TO_MEANING
  MEANING_TO_WORD
  READING_TO_MEANING
  AUDIO_TO_MEANING
}

model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String
  displayName  String?

  role     UserRole @default(STUDENT)
  isActive Boolean  @default(true)

  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  lessonProgress LessonProgress[]
  wordStates     UserWordState[]
  reviewEvents   ReviewEvent[]
  studySessions  StudySession[]
  savedWords     SavedWord[]
  authSessions   AuthSession[]
  accountTokens  AccountActionToken[]
  quizAttempts   QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id String @id @default(uuid())

  sourceCourseId Int? @unique

  code           String?
  title          String
  titleEn        String?
  description    String?
  descriptionEn  String?
  imageUrl       String?
  outcomeVi      String?
  outcomeEn      String?
  sourceMetadata Json?

  level     String?
  sortOrder Int     @default(0)

  status ContentStatus @default(DRAFT)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id String @id @default(uuid())

  sourceLessonId Int?

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  code           String?
  title          String
  titleEn        String?
  description    String?
  descriptionEn  String?
  imageUrl       String?
  sourceMetadata Json?

  sortOrder Int @default(0)

  status ContentStatus @default(DRAFT)

  lessonWords   LessonWord[]
  progress      LessonProgress[]
  studySessions StudySession[]
  quizAttempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, sourceLessonId])
  @@index([courseId])
}

model Word {
  id String @id @default(uuid())

  sourceWordId Int? @unique

  code String?

  writtenForm String?
  reading     String
  romaji      String?

  meaningVi String
  meaningEn String?

  partOfSpeech   String?
  searchForms    String[] @default([])
  otherForm      String?
  sourceWmId     Int?
  sourceReview   Int?
  sourceMetadata Json?

  audioUrl   String?
  pictureUrl String?

  lessonWords LessonWord[]
  examples    ExampleSentence[]

  userStates   UserWordState[]
  reviewEvents ReviewEvent[]
  savedByUsers SavedWord[]
  sessionItems StudySessionItem[]
  quizItems    QuizAttemptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reading])
  @@index([writtenForm])
}

model LessonWord {
  lessonId String
  wordId   String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  position Int?

  @@id([lessonId, wordId])
  @@index([wordId])
}

model ExampleSentence {
  id String @id @default(uuid())

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  sourceKey String? @unique

  japanese   String
  vietnamese String?
  english    String?

  createdAt DateTime @default(now())

  @@index([wordId])
}

model LessonProgress {
  id String @id @default(uuid())

  userId   String
  lessonId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  status          LessonProgressStatus @default(IN_PROGRESS)
  currentPosition Int                  @default(0)

  startedAt     DateTime  @default(now())
  lastStudiedAt DateTime  @default(now())
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId, lastStudiedAt])
}

model UserWordState {
  id String @id @default(uuid())

  userId String
  wordId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Restrict)

  masteryLevel   Int   @default(0)
  memoryStrength Float @default(1.0)

  firstLearnedAt DateTime  @default(now())
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  correctCount   Int @default(0)
  incorrectCount Int @default(0)
  lapseCount     Int @default(0)
  reviewCount    Int @default(0)
  streak         Int @default(0)

  averageResponseTimeMs Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([wordId])
  @@index([userId, nextReviewAt])
}

model StudySession {
  id String @id @default(uuid())

  userId   String
  lessonId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  type   StudySessionType
  status StudySessionStatus @default(ACTIVE)

  totalItems   Int @default(0)
  correctItems Int @default(0)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  reviewEvents ReviewEvent[]
  items        StudySessionItem[]
  quizAttempt  QuizAttempt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([lessonId])
}

model ReviewEvent {
  id String @id @default(uuid())

  userId    String
  wordId    String
  sessionId String?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  word    Word          @relation(fields: [wordId], references: [id], onDelete: Restrict)
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  isCorrect Boolean
  rating    ReviewRating?

  responseTimeMs Int?

  previousMasteryLevel   Int?
  newMasteryLevel        Int?
  previousMemoryStrength Float?
  newMemoryStrength      Float?

  idempotencyKey String? @unique

  reviewedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([wordId, reviewedAt])
  @@index([sessionId])
}

model SavedWord {
  id String @id @default(uuid())

  userId String
  wordId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Restrict)

  source SavedWordSource @default(MANUAL)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([wordId])
}

model AuthSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AccountActionToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AccountTokenType
  tokenHash String           @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type, usedAt])
  @@index([expiresAt])
}

model StudySessionItem {
  id String @id @default(uuid())

  sessionId String
  wordId    String

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word    Word         @relation(fields: [wordId], references: [id], onDelete: Restrict)

  position      Int
  scheduledFor  DateTime?
  priorityScore Float     @default(0)
  answeredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, wordId])
  @@unique([sessionId, position])
  @@index([wordId])
  @@index([sessionId, answeredAt])
}

model QuizAttempt {
  id String @id @default(uuid())

  userId    String
  lessonId  String
  sessionId String @unique

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  status         QuizAttemptStatus @default(ACTIVE)
  totalQuestions Int
  correctAnswers Int               @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  items QuizAttemptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([lessonId, startedAt])
}

model QuizAttemptItem {
  id String @id @default(uuid())

  attemptId String
  wordId    String

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  word    Word        @relation(fields: [wordId], references: [id], onDelete: Restrict)

  position     Int
  questionType QuizQuestionType

  optionWordIds String[]

  selectedWordId       String?
  isCorrect            Boolean?
  responseTimeMs       Int?
  answerIdempotencyKey String?   @unique
  answeredAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, position])
  @@unique([attemptId, wordId])
  @@index([wordId])
  @@index([attemptId, answeredAt])
}
